---
import { captionMarker, maximumSteps, minimumSteps, stepMarker } from "./stepper-protocol.mjs";

interface Props {
  name: string;
  title: string;
}

const { name, title } = Astro.props;

if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(name)) {
  throw new Error(`Stepper: the name "${name}" must be lowercase kebab-case, because it becomes part of the ids`);
}

const [outside, ...chunks] = (await Astro.slots.render("default")).split(stepMarker);

if (outside.trim() !== "") {
  throw new Error(`Stepper "${name}": put only Step components inside it`);
}

if (chunks.length < minimumSteps || chunks.length > maximumSteps) {
  throw new Error(`Stepper "${name}": it has ${chunks.length} steps, and it needs ${minimumSteps} to ${maximumSteps}`);
}

const total = chunks.length;
const groupName = `stepper-${name}`;
const radioId = (step: number) => `${groupName}-${step}`;
const steps = chunks.map((chunk, index) => {
  const [scene, caption] = chunk.split(captionMarker);
  return { number: index + 1, scene, caption: caption ?? "" };
});
---

<div class="stepper not-content" role="group" aria-label={title}>
  <div class="stepper-head">{title}</div>
  {
    steps.map(({ number, scene, caption }) => (
      <>
        <input
          class="stepper-radio"
          type="radio"
          name={groupName}
          id={radioId(number)}
          value={number}
          checked={number === 1}
          aria-label={`Paso ${number} de ${total}`}
        />
        <div class="stepper-stage">
          <div class="stepper-scene" set:html={scene} />
          <div class="stepper-caption" set:html={caption} />
        </div>
        <div class="stepper-player">
          <div class="stepper-nav" aria-hidden="true">
            {number > 1 ? (
              <label class="stepper-button" for={radioId(number - 1)}>
                ◀
              </label>
            ) : (
              <span class="stepper-button" data-off>
                ◀
              </span>
            )}
            {number < total ? (
              <label class="stepper-button" data-primary for={radioId(number + 1)}>
                ▶
              </label>
            ) : (
              <label class="stepper-button" for={radioId(1)}>
                ↺
              </label>
            )}
          </div>
          <div class="stepper-segments" aria-hidden="true">
            {steps.map((segment) => (
              <label class="stepper-segment" data-filled={segment.number <= number || undefined} for={radioId(segment.number)} />
            ))}
          </div>
          <span class="stepper-count">
            {number}/{total}
          </span>
        </div>
      </>
    ))
  }
</div>
