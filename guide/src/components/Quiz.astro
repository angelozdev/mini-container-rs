---
interface Props {
  kind: "prediction" | "closing";
}

const { kind } = Astro.props;
const labels = { prediction: "Predicción", closing: "Cierre" };
---

<form class="quiz" data-kind={kind}>
  <div class="quiz-head">
    <span class="quiz-kind">{labels[kind]}</span>
    <span class="quiz-hint">Elige una respuesta</span>
  </div>
  <fieldset class="quiz-group">
    <legend class="quiz-question"><slot name="question" /></legend>
    <slot />
  </fieldset>
</form>
