---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { findSectionPosition, groupsAbove, type SidebarEntry } from "../lib/sections";
import PageProperties from "./PageProperties.astro";

const { entry, sidebar } = Astro.locals.starlightRoute;
const { icon, title } = entry.data;
const groups = groupsAbove(sidebar as SidebarEntry[]) ?? [];
const section = findSectionPosition(sidebar as SidebarEntry[]);
const body = entry.body ?? "";
---

{
  groups.length > 0 && (
    <nav class="page-crumb" aria-label="Ruta">
      {groups.map((group) => (
        <>
          <span>{group}</span>
          <span class="page-crumb-separator" aria-hidden="true">/</span>
        </>
      ))}
      <span class="page-crumb-current">{title}</span>
    </nav>
  )
}
{icon && <div class="page-icon" aria-hidden="true">{icon}</div>}
<Default {...Astro.props}><slot /></Default>
{
  section && (
    <PageProperties position={section.position} total={section.total} body={body} title={title} />
  )
}
