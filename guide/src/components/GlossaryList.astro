---
import { getCollection } from "astro:content";
import entries from "../glossary.json";
import DefinitionText from "./DefinitionText.astro";

const glossaryId = "glossary";
const sectionSeparator = " · ";

const readingRank = (page) => (page.id === "index" ? "" : page.id);
const pages = (await getCollection("docs"))
  .filter((page) => page.id !== glossaryId)
  .sort((left, right) => readingRank(left).localeCompare(readingRank(right), "en", { numeric: true }));

const hrefOf = (page) => (page.id === "index" ? "/" : `/${page.id}/`);
const sectionOf = (page) => page.data.title.split(sectionSeparator)[0];
const firstPageUsing = (id) => pages.find((page) => page.body?.includes(`<Term id="${id}">`));

const listed = [...entries]
  .sort((left, right) => left.term.localeCompare(right.term, "es"))
  .map((entry) => ({ ...entry, firstPage: firstPageUsing(entry.id) }));
---

<dl class="glossary not-content">
  {
    listed.map(({ id, term, definition, firstPage }) => (
      <div class="glossary-entry" id={id}>
        <dt>{term}</dt>
        <dd>
          <span class="glossary-definition">
            <DefinitionText text={definition} />
          </span>
          {firstPage && (
            <span class="glossary-seen">
              Aparece en <a href={hrefOf(firstPage)}>{sectionOf(firstPage)}</a>.
            </span>
          )}
        </dd>
      </div>
    ))
  }
</dl>
